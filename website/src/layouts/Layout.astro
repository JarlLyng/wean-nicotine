---
/**
 * Every page's frame: head, <ij-nav>, the page, the guides and <ij-footer>.
 *
 * The site takes Wean's identity from the IAMJARL design system (#396): a misty
 * grey-blue ground, charcoal text, magenta for strokes and Instrument Sans for
 * headlines, light whatever the visitor's setting. The design system's files
 * are copied into public/iamjarl-design/ by scripts/sync-design.mjs and served
 * from this origin, so the site still loads nothing from a third party. The
 * home pages are built from the marketing kit's sections (KitHome.astro); the
 * other pages keep their own sections and take the identity through
 * styles/tokens.css.
 */
import '../styles/global.css';
import LanguageSwitcher from '../components/LanguageSwitcher.astro';
import StoreButton from '../components/StoreButton.astro';
import { COMPANY_NAME, SITE_NAME } from '../lib/site';
import smartAppBanner from '../store/wean-nicotine.head.html?raw';
import crossLinks from '../design/cross-links.html?raw';
import { getLangFromUrl, languageLinks, useTranslations, useTranslatedPath } from '../i18n/utils';
import { languages } from '../i18n/ui';
import { GUIDE_LINKS } from '../i18n/footer-links';
import { translationsFor } from '../i18n/translations';

export interface Props {
	title?: string;
	description?: string;
	canonicalPath?: string;
	noindex?: boolean;
	/**
	 * Which locales this page actually exists in, for hreflang and the language
	 * switcher. Defaults to THIS page's locale only.
	 *
	 * The default is deliberately fail-closed. `useTranslatedPath` only swaps the
	 * language prefix, it does not translate the slug, so claiming a locale the
	 * page does not have emits an hreflang to a URL that 404s and puts a dead
	 * link in the switcher. Pass the full list only on pages whose translations
	 * really exist at the same slug.
	 */
	availableLocales?: string[];
	/**
	 * Path or absolute URL to the social-share image. Defaults to the brand
	 * `/og-image.png`. Pass per-page when an SEO landing page or blog post
	 * has a topical image that converts better than the generic one.
	 */
	ogImage?: string;
	/**
	 * Open Graph type. Defaults to `website`. Blog posts pass `article`, which
	 * every post was missing (#307).
	 */
	ogType?: 'website' | 'article';
	/** More JSON-LD for this page, such as the home page's FAQPage. */
	structuredData?: Record<string, unknown>[];
	/** A line after the copyright in the footer's fineprint. */
	fineprint?: string;
	/** Hide the nav's Download button while this element is on screen. */
	ctaAfter?: string;
}

const {
	title,
	description,
	canonicalPath,
	noindex = false,
	availableLocales,
	ogImage,
	ogType = 'website',
	structuredData = [],
	fineprint,
	ctaAfter,
} = Astro.props;

const lang = getLangFromUrl(Astro.url);
// A page in a translation set (guides at different slugs per locale) takes
// its alternates from the set; everything else swaps the language prefix.
const translationSet = translationsFor(Astro.url.pathname);
const localesForHreflang = translationSet ? Object.keys(translationSet) : (availableLocales ?? [lang]);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
const home = translatePath('/');
const otherLanguages = languageLinks(Astro.url, localesForHreflang, translationSet).filter((l) => !l.isCurrent);
const guides = GUIDE_LINKS[lang];

const pageTitle = title ? `${title} | ${SITE_NAME}` : `${SITE_NAME}, Snus & Nicotine Pouch Reduction App`;
const pageDescription =
	description ??
	'Reduce snus and nicotine pouches gradually with a calm, private app. Track daily allowance, log use in one tap, handle cravings, and see progress over time.';

const canonicalUrl = new URL(canonicalPath ?? Astro.url.pathname, Astro.site).toString();
// PNG (not SVG). Most social platforms reject SVG og:image
// public/og-image.png is its own source: a hand-made composite of app screens,
// 1200x630 and under 1 MB. Nothing in the repo generates it. It is also the
// GitHub social preview, uploaded by hand in Settings, so replace it there too.
const ogImageUrl = new URL(ogImage ?? '/og-image.png', Astro.site).toString();

// The Offer comes from the design system's registry, in the currency of the
// storefront this locale quotes (#393), so it always matches the facts line.
const offers = import.meta.glob<Record<string, string>>('../store/*.offer.json', {
	import: 'default',
	eager: true,
});
const offer = offers[`../store/wean-nicotine.${lang}.offer.json`] ?? offers['../store/wean-nicotine.en.offer.json'];

const appData: Record<string, unknown> = {
	'@context': 'https://schema.org',
	'@type': 'MobileApplication',
	name: SITE_NAME,
	operatingSystem: 'iOS',
	applicationCategory: 'HealthApplication',
	description: 'A calm, private app for reducing snus and nicotine pouches gradually with daily tracking, craving support tools, and weekly progress.',
	url: new URL('/', Astro.site).toString(),
	offers: offer,
	downloadUrl: offer.url,
	installUrl: offer.url,
};
const year = new Date().getFullYear();
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
		<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
		<link rel="icon" type="image/png" sizes="192x192" href="/icon-192.png" />
		<link rel="icon" type="image/png" sizes="512x512" href="/icon-512.png" />
		<title>{pageTitle}</title>
		<meta name="description" content={pageDescription} />
		<link rel="canonical" href={canonicalUrl} />
		<meta name="theme-color" content="#E6ECEF" />
		<!-- Safari's Smart App Banner, from the design system's registry (#393) -->
		<Fragment set:html={smartAppBanner} />

		{localesForHreflang.map((abbr) => (
			<link
				rel="alternate"
				hreflang={abbr}
				href={new URL(
					translationSet?.[abbr as keyof typeof translationSet] ??
						translatePath(Astro.url.pathname, abbr as keyof typeof languages),
					Astro.site,
				).toString()}
			/>
		))}
		{localesForHreflang.includes('en') && (
			<link
				rel="alternate"
				hreflang="x-default"
				href={new URL(translationSet?.en ?? translatePath(Astro.url.pathname, 'en'), Astro.site).toString()}
			/>
		)}

		{noindex ? (
			<meta name="robots" content="noindex,nofollow" />
		) : (
			<meta name="robots" content="index,follow" />
		)}

		<meta property="og:type" content={ogType} />
		<meta property="og:site_name" content={SITE_NAME} />
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={pageDescription} />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:image" content={ogImageUrl} />
		<meta property="og:image:type" content="image/png" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content={`${SITE_NAME}, reduce snus and nicotine pouches step by step`} />

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={pageTitle} />
		<meta name="twitter:description" content={pageDescription} />
		<meta name="twitter:image" content={ogImageUrl} />
		<meta name="twitter:image:alt" content={`${SITE_NAME}, reduce snus and nicotine pouches step by step`} />

		<meta name="generator" content={Astro.generator} />
		{[appData, ...structuredData].map((data) => (
			<script type="application/ld+json" set:html={JSON.stringify(data)} />
		))}

		<!-- The IAMJARL design system, one release, from this origin (scripts/sync-design.mjs).
		     Light only: the identity sheet holds the page on grey-blue whatever the
		     visitor's setting. The display face is preloaded for the first headline. -->
		<link rel="preload" href="/iamjarl-design/fonts/instrument-sans-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />
		<link rel="stylesheet" href="/iamjarl-design/css/tokens.css" />
		<link rel="stylesheet" href="/iamjarl-design/identity/wean-nicotine.css" />
		<link rel="stylesheet" href="/iamjarl-design/fonts/instrument-sans.css" />
		<link rel="stylesheet" href="/iamjarl-design/kit/kit.css" />
		<script type="module" src="/iamjarl-design/components/ij-nav.js"></script>
		<script type="module" src="/iamjarl-design/components/ij-footer.js"></script>
		<script type="module" src="/iamjarl-design/kit/kit.js"></script>

		<!-- Umami Analytics (privacy-friendly, cookie-free) -->
		<script defer src="https://umami-iamjarl.vercel.app/script.js" data-website-id="ab39d27c-ff32-49c4-b9e3-4c8407aad2b8"></script>
	</head>

	<body class="ij-page">
		<ij-nav label={t('nav.label')} skip-to="main" cta-after={ctaAfter}>
			<a slot="brand" href={home}>Wean</a>
			<a slot="links" href={`${home}#how`}>{t('nav.how')}</a>
			<a slot="links" href={`${home}#plan`}>{t('nav.plan')}</a>
			<a slot="links" href={`${home}#faq`}>{t('nav.faq')}</a>
			<LanguageSwitcher availableLocales={localesForHreflang} translations={translationSet} />
			<StoreButton locale={lang} placement="nav" />
		</ij-nav>

		<main id="main">
			<slot />
		</main>

		{/* The guides, linked from every page in the reader's own language, so
		    each locale's cluster is reachable from anywhere in it (#303). English
		    readers are not sent to Nordic pages, nor the other way (#98). */}
		<nav class="ij-container site-guides" aria-label={guides.label}>
			{guides.groups.map((group) => (
				<div>
					<p class="site-guides__heading">{group.heading}</p>
					<ul>
						{group.links.map((link) => (
							<li><a href={link.href}>{link.label}</a></li>
						))}
					</ul>
				</div>
			))}
		</nav>

		<ij-footer app="wean-nicotine" tagline={t('footer.tagline')}>
			<a slot="links" href="/blog/">{t('nav.blog')}</a>
			<a slot="links" href={translatePath('/privacy')}>{t('nav.privacy')}</a>
			<a slot="links" href={translatePath('/support')}>{t('nav.support')}</a>
			{otherLanguages.map((l) => (
				<a slot="links" href={l.href} hreflang={l.code} lang={l.code}>{l.label}</a>
			))}
			<Fragment set:html={crossLinks} />
			<p slot="fineprint">© {year} <a href="https://iamjarl.com">{COMPANY_NAME}</a>.{fineprint && ` ${fineprint}`}</p>
			{/* No slot on purpose: shown only if the component never loads. */}
			<p>
				<a href="/blog/">{t('nav.blog')}</a> · <a href={translatePath('/privacy')}>{t('nav.privacy')}</a> ·
				<a href={translatePath('/support')}>{t('nav.support')}</a> · © {year} {COMPANY_NAME}.{fineprint && ` ${fineprint}`}
			</p>
		</ij-footer>
	</body>
</html>

<style>
	/* A link inside the fineprint is not slotted itself, so neither the kit nor
	   <ij-footer> colours it; it takes the fineprint's own colour. */
	ij-footer [slot='fineprint'] a {
		color: inherit;
	}
	.site-guides {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
		gap: var(--ij-spacing-xxl);
		padding-block: var(--ij-mkt-space-block) 0;
		border-top: 1px solid var(--ij-color-border-subtle);
		margin-top: var(--ij-mkt-space-section);
	}
	.site-guides__heading {
		margin: 0 0 var(--ij-spacing-sm);
		font-size: var(--ij-mkt-small-size);
		font-weight: var(--ij-font-weight-semibold);
		color: var(--ij-color-text-primary);
	}
	.site-guides ul {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: var(--ij-spacing-sm);
	}
	.site-guides a {
		font-size: var(--ij-mkt-small-size);
		color: var(--ij-color-text-secondary);
		text-decoration: none;
	}
	.site-guides a:hover {
		color: var(--ij-color-accent-text);
		text-decoration: underline;
	}
</style>
