---
export interface Props {
	id?: string;
	title?: string;
	lede?: string;
	/**
	 * The title's heading level. Pass 1 when this section's title is the
	 * page's title (the support pages, 404), so the page has its one <h1>.
	 */
	level?: 1 | 2;
}

const { id, title, lede, level = 2 } = Astro.props;
const Heading = level === 1 ? 'h1' : 'h2';
---

<section id={id} class="section">
	<div class="container">
		{title && (
			<header class="section__header">
				<Heading class="section__title">{title}</Heading>
				{lede && <p class="section__lede">{lede}</p>}
			</header>
		)}
		<div class="section__content">
			<slot />
		</div>
	</div>
</section>

<style>
	.section {
		padding: clamp(64px, 10vw, 128px) 0;
	}

	.section__header {
		margin-bottom: var(--space-huge);
		text-align: center;
		max-width: 800px;
		margin-left: auto;
		margin-right: auto;
	}

	.section__title {
		margin: 0 0 var(--space-md);
		font-size: var(--font-size-xxl);
		line-height: var(--line-height-tight);
	}

	.section__lede {
		margin: 0;
		color: var(--text-secondary);
		font-size: var(--font-size-lg);
		line-height: var(--line-height-relaxed);
	}
</style>

