---
/**
 * The design system's store button (#393), rendered into the served HTML so
 * crawlers and AI assistants see the badge, link and facts without JavaScript.
 *
 * The fragments in src/store/ are generated in iamjarl-design from its app
 * registry and copied in by scripts/sync-design.mjs: price, OS floor, campaign
 * link and the store-click event all come from there. Do not hand-write a
 * store link, price or OS line next to one of these. The site is light only
 * (#396), so every badge is the black one.
 *
 * - hero: the page's main badge, with the facts line.
 * - midpage: a later repeat further down, so the click says where it was.
 * - footer: the closing badge above the footer.
 * - nav: <ij-nav>'s Download button. Rendered bare, because a slotted element
 *   has to be the nav's own child.
 */
import type { Locale } from '../i18n/translations';

interface Props {
	locale: Locale;
	placement?: 'hero' | 'midpage' | 'footer' | 'nav';
	/** Centre the badge and facts line, for a centred section. */
	align?: 'start' | 'center';
}

const { locale, placement = 'hero', align = 'start' } = Astro.props;

const fragments = import.meta.glob<string>('../store/*.html', {
	query: '?raw',
	import: 'default',
	eager: true,
});
const suffix = { hero: '.black', midpage: '.midpage.black', footer: '.footer.black', nav: '.nav' }[placement];
const html = fragments[`../store/wean-nicotine.${locale}${suffix}.html`];
if (!html) throw new Error(`No store fragment for ${locale} ${placement}; run scripts/sync-design.mjs`);
---

{
	placement === 'nav' ? (
		<Fragment set:html={html} />
	) : (
		<div class:list={['store-cta', align === 'center' && 'store-cta--center']} set:html={html} />
	)
}
