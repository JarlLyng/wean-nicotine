---
/**
 * The language menu in <ij-nav>'s one secondary slot (#396).
 *
 * Four languages do not fit the nav as links, so it is a disclosure: the
 * current language, and the other three under it. Each goes to the same page
 * in that language where it exists, and to that language's home otherwise
 * (languageLinks). It works without JavaScript; the small script only closes
 * it on Escape or a click elsewhere. The footer lists the same links.
 */
import type { TranslationSet } from '../i18n/translations';
import { getLangFromUrl, languageLinks, useTranslations } from '../i18n/utils';

interface Props {
	availableLocales: string[];
	translations?: TranslationSet;
}

const { availableLocales, translations } = Astro.props;
const links = languageLinks(Astro.url, availableLocales, translations);
const current = links.find((l) => l.isCurrent)!;
const t = useTranslations(getLangFromUrl(Astro.url));
---

<details slot="secondary" class="lang-menu">
	<summary><span class="visually-hidden">{t('nav.language')}: </span>{current.label}</summary>
	<ul>
		{
			links
				.filter((l) => !l.isCurrent)
				.map((l) => (
					<li>
						<a href={l.href} hreflang={l.code} lang={l.code}>
							{l.label}
						</a>
					</li>
				))
		}
	</ul>
</details>

<script>
	const menu = document.querySelector<HTMLDetailsElement>('details.lang-menu');
	if (menu) {
		document.addEventListener('click', (e) => {
			if (menu.open && !menu.contains(e.target as Node)) menu.open = false;
		});
		menu.addEventListener('keydown', (e) => {
			if (e.key === 'Escape' && menu.open) {
				menu.open = false;
				menu.querySelector('summary')?.focus();
			}
		});
	}
</script>

<style>
	/* <ij-nav> makes its secondary item an inline-flex button; open, the list
	   goes under the language, not beside it. */
	.lang-menu {
		position: relative;
		flex-direction: column;
		align-items: stretch;
	}
	.lang-menu summary {
		cursor: pointer;
		list-style: none;
	}
	.lang-menu summary::-webkit-details-marker {
		display: none;
	}
	.lang-menu summary::after {
		content: '';
		display: inline-block;
		width: 0.4em;
		height: 0.4em;
		margin-left: 0.5em;
		border-right: 1.5px solid currentColor;
		border-bottom: 1.5px solid currentColor;
		transform: translateY(-0.2em) rotate(45deg);
	}
	.lang-menu ul {
		list-style: none;
		margin: 0;
		padding: var(--ij-spacing-xs) 0;
	}
	.lang-menu a {
		display: block;
		padding: var(--ij-spacing-sm) 0;
		color: var(--ij-color-text-primary);
		text-decoration: none;
	}
	.lang-menu a:hover {
		text-decoration: underline;
		text-decoration-color: var(--ij-color-accent);
		text-underline-offset: 0.2em;
	}
	/* On wide screens the nav is one bar, so the list drops below it. Below
	   768px <ij-nav> folds this into its menu, where the list stays in flow. */
	@media (min-width: 768px) {
		.lang-menu ul {
			position: absolute;
			top: calc(100% + var(--ij-spacing-sm));
			right: 0;
			min-width: 9em;
			padding: var(--ij-spacing-xs) var(--ij-spacing-lg);
			background: var(--ij-color-bg-card);
			border: 1px solid var(--ij-color-border-subtle);
			border-radius: var(--ij-radius-md);
			box-shadow: 0 12px 32px -16px color-mix(in srgb, var(--ij-color-text-primary) 35%, transparent);
		}
	}
</style>
