---
import { storeTracking, type StorePlacement } from '../lib/analytics';
import { getLangFromUrl } from '../i18n/utils';

type Variant = 'primary' | 'secondary' | 'ghost';

export interface Props {
	href?: string;
	variant?: Variant;
	disabled?: boolean;
	external?: boolean;
	ariaLabel?: string;
	/** Umami event name. If set, clicks are tracked. */
	trackEvent?: string;
	/**
	 * Where this button sits on the page. Required for App Store links so the
	 * click data can tell surfaces apart (#304); a generic default would put
	 * every unlabelled button in one bucket, which is what it used to do.
	 */
	placement?: StorePlacement;
}

const {
	href,
	variant = 'primary',
	disabled = false,
	external = false,
	ariaLabel,
	trackEvent,
	placement,
} = Astro.props;

const target = external ? '_blank' : undefined;
const rel = external ? 'noopener noreferrer' : undefined;
const isAppStoreLink = typeof href === 'string' && href.includes('apps.apple.com');
const lang = getLangFromUrl(Astro.url);

// App Store links go through the shared helper. Anything else keeps the old
// bare `trackEvent` behaviour.
const appStoreAttrs = isAppStoreLink && !disabled ? storeTracking(placement ?? 'midpage', lang) : {};
---

<a
	class:list={['btn', `btn--${variant}`, disabled && 'is-disabled']}
	href={disabled ? undefined : href}
	target={disabled ? undefined : target}
	rel={disabled ? undefined : rel}
	aria-disabled={disabled ? 'true' : undefined}
	aria-label={ariaLabel}
	tabindex={disabled ? -1 : undefined}
	data-umami-event={!isAppStoreLink ? trackEvent : undefined}
	{...appStoreAttrs}
>
	<slot />
</a>

<style>
	.btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 12px;
		padding: 14px 28px;
		border-radius: var(--radius-xl);
		font-family: var(--font-display);
		font-size: var(--font-size-base);
		font-weight: var(--font-weight-bold);
		letter-spacing: -0.01em;
		text-decoration: none;
		transition: border-color 0.2s ease;
		cursor: pointer;
		white-space: nowrap;
	}

	/* .btn.btn--x, not .btn--x: the kit gives every content link the text
	   magenta (.ij-page a), and that selector would outrank a single class. */

	/* IAMJARL focus ring: 2px outline, 2px offset. Visible only for keyboard /
	   assistive nav, not mouse clicks. */
	.btn:focus-visible {
		outline: 2px solid var(--primary);
		outline-offset: 2px;
	}

	/* The identity's accent as a fill, with its on-colour: magenta and black
	   (#396). The label underlines on hover rather than the button moving. */
	.btn.btn--primary {
		background: var(--accent);
		color: var(--on-accent);
		border: 1px solid transparent;
	}

	.btn.btn--primary:hover {
		text-decoration: underline;
		text-underline-offset: 0.2em;
	}

	.btn.btn--secondary {
		background: var(--surface);
		color: var(--text-primary);
		border: 1px solid var(--border-default);
	}

	.btn.btn--secondary:hover {
		border-color: var(--accent);
	}

	.btn.btn--ghost {
		background: transparent;
		color: var(--text-secondary);
		border: 1px solid transparent;
	}

	.btn.btn--ghost:hover {
		background: var(--bg-muted);
		color: var(--text-primary);
	}

	.is-disabled {
		opacity: 0.5;
		cursor: not-allowed;
		pointer-events: none;
	}
</style>

