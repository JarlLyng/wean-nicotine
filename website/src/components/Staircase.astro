---
/**
 * An example taper (#396), from the app's own maths.
 *
 * The steps come from lib/staircase.ts, which calls the app's
 * calculateDailyAllowance, getDisplayAllowance and estimateWeeksToZero: a
 * caption, and the table week by week. It was also drawn as a staircase in the
 * coast drawings' loose stroke; that line left with the drawings
 * (iamjarl-design#90), and the plan stays as text.
 */
import { EXAMPLE_STAIRCASE } from '../lib/staircase';
import { HOME_COPY } from '../i18n/home-copy';
import type { Locale } from '../i18n/translations';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const copy = HOME_COPY[locale].staircase;
const s = EXAMPLE_STAIRCASE;
---

<figure class="ij-card staircase">
	<figcaption class="ij-small">
		<strong>{copy.exampleLabel}.</strong>{` ${copy.summary(s)} ${copy.paceNote}`}
	</figcaption>
	<details class="staircase__table">
		<summary>{copy.tableCaption}</summary>
		<table>
			<thead>
				<tr><th scope="col">{copy.tableWeeks}</th><th scope="col">{copy.tablePerDay}</th></tr>
			</thead>
			<tbody>
				{s.runs.map((run, i) => (
					<tr>
						<td>{copy.weeks(run.fromWeek, run.toWeek, i === s.runs.length - 1)}</td>
						<td>{copy.perDay(run.perDay)}</td>
					</tr>
				))}
			</tbody>
		</table>
	</details>
</figure>

<style>
	.staircase figcaption strong {
		color: var(--ij-color-text-primary);
		font-weight: var(--ij-font-weight-semibold);
	}
	.staircase__table {
		font-size: var(--ij-mkt-small-size);
		color: var(--ij-color-text-secondary);
	}
	.staircase__table summary {
		cursor: pointer;
		color: var(--ij-color-text-primary);
	}
	.staircase__table summary::marker {
		color: var(--ij-color-accent);
	}
	.staircase__table table {
		border-collapse: collapse;
		margin-top: var(--ij-spacing-sm);
	}
	.staircase__table th,
	.staircase__table td {
		text-align: left;
		padding: var(--ij-spacing-xs) var(--ij-spacing-lg) var(--ij-spacing-xs) 0;
		font-variant-numeric: tabular-nums;
	}
</style>
